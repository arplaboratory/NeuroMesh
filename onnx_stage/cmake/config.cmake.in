@PACKAGE_INIT@
include(CMakeFindDependencyMacro)
find_dependency(neuromesh_device_interface CONFIG)
if(NOT TARGET NeuroMesh::cuda_execution)
  set(neuromesh_onnx_stage_FOUND FALSE)
  set(neuromesh_onnx_stage_NOT_FOUND_MESSAGE "device_interface must enable CUDA")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/FindONNXRuntime.cmake")
if(NOT ONNXRuntime_FOUND)
  set(neuromesh_onnx_stage_FOUND FALSE)
  set(neuromesh_onnx_stage_NOT_FOUND_MESSAGE "ONNX Runtime headers/library are required")
  return()
endif()
include("${CMAKE_CURRENT_LIST_DIR}/NeuroMeshOnnxTargets.cmake")
