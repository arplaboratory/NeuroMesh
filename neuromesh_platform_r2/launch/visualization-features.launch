<launch>
  <arg name="agent_num" default="1"/>


  <node pkg="neuromesh_platform_r2" exec="visualization_node" name="visualization$(var agent_num)">
    <param name="input_topic" value="/race13/features_agent$(var agent_num)_local$(var agent_num)"/>
    <param name="output_topic" value="visualization$(var agent_num)_features"/>
    <param name="use_features" value="true"/>
    <param name="datatype" value="fp32"/>
    <param name="modeltype" value="depth"/>
    <param name="height" value="320"/>
    <param name="width" value="1024"/>
  </node>
</launch>
