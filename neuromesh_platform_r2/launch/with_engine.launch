<launch>
  <arg name="agent_num" default="1"/>

  <node pkg="neuromesh_platform_r2" exec="toy_implementation" name="agent$(var agent_num)" >
    <param name="id" value="agent$(var agent_num)"/>
    <param name="agents" value="agent1,agent2"/>
    <param name="output_topic" value="agent$(var agent_num)_gnn_output"/>

    <remap from="/camera" to="camera$(var agent_num)"/>
    <remap from="/tensorrt_input" to="/tensorrt_input$(var agent_num)"/>
    <remap from="/tensorrt_output" to="/tensorrt_output$(var agent_num)"/>
  </node>

  <node pkg="tensorrt_engine" exec="tensorrt_engine" name="engine$(var agent_num)">
    <param name="model_path" value="$(find-pkg-share tensorrt_engine)/models/mono+stereo_1024x320.simplified.onnx"/>
    <param name="input_dimensions" value="1,3,320,1024"/>
    <param name="output_dimensions" value="1,1,320,1024"/>
    <param name="tensor_type" value="fp32"/>

    <remap from="/tensorrt_input" to="/tensorrt_input$(var agent_num)"/>
    <remap from="/tensorrt_output" to="/tensorrt_output$(var agent_num)"/>
  </node>

</launch>
