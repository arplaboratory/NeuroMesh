<launch>
  <arg name="agent_num" default="1"/>


  <node pkg="neuromesh_platform_r2" exec="visualization_node" name="visualization$(var agent_num)">
    <param name="input_topic" value="/race13/agent1_gnn_output"/>
    <param name="output_topic" value="visualization$(var agent_num)"/>
    <param name="use_features" value="false"/>
    <param name="datatype" value="fp32"/>
    <param name="modeltype" value="depth"/>
    <param name="height" value="512"/>
    <param name="width" value="512"/>
  </node>
</launch>
